{
  "expo": {
    "name": "SelfTrack",
    "slug": "selftrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#E8F8F0",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selftrack.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library for profile pictures and journal attachments.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use your camera to take photos.",
        "NSFaceIDUsageDescription": "Allow $(PRODUCT_NAME) to use Face ID for biometric authentication.",
        "NSMotionUsageDescription": "Allow $(PRODUCT_NAME) to access motion sensors to count your steps."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.selftrack.app",
      "versionCode": 5,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-local-authentication",
      "expo-speech-recognition",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-notifications",
      "expo-audio"
    ],
    "scheme": "selftrack",
    "extra": {
      "eas": {
        "projectId": "7bd2b75d-a0a8-412f-9945-aa194a4a8529"
      }
    }
  }
}
