# SelfTrack Backend Environment Configuration
PORT=5000
DATABASE_URL=sqlite+aiosqlite:///./selftrack.db
SECRET_KEY=selftrack-ultra-secure-jwt-secret-key-2026-production

# -------------------------------------------------------------
# SMS CELLULAR GATEWAY CONFIGURATION
# -------------------------------------------------------------
# Supported values: "auto" (default), "twilio", "fast2sms", "msg91", "console"
SMS_PROVIDER=auto

# Set to "false" in production to hide development OTP from API response
SHOW_DEV_OTP_IN_RESPONSE=true

# Option A: Twilio (Global SMS for all countries)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option B: Fast2SMS (Indian Mobile Numbers +91 - Quick OTP Route)
# Get from: https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=

# Option C: MSG91 (Indian / Global SMS Gateway)
# Get from: https://control.msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# -------------------------------------------------------------
# AI COACHING KEYS
# -------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
